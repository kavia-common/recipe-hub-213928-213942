# Recipe Hub Frontend - Environment Variables Template
# Copy this file to .env and update values as needed

# ============================================================================
# API Configuration
# ============================================================================

# Primary API base URL (used by src/api/client.js)
# Local development: http://localhost:8000
# Deployment: https://your-backend-domain.com
REACT_APP_API_BASE=http://localhost:8000

# Alternative API base URL (fallback if REACT_APP_API_BASE is not set)
REACT_APP_BACKEND_URL=http://localhost:8000

# Frontend URL (used for CORS and redirects)
REACT_APP_FRONTEND_URL=http://localhost:3000

# WebSocket URL (if real-time features are added in future)
REACT_APP_WS_URL=ws://localhost:8000/ws

# Health check endpoint path
REACT_APP_HEALTHCHECK_PATH=/healthz

# ============================================================================
# Development Settings
# ============================================================================

# Node environment
REACT_APP_NODE_ENV=development

# Port for development server
REACT_APP_PORT=3000

# Enable source maps for debugging
REACT_APP_ENABLE_SOURCE_MAPS=true

# Logging level (info, debug, warn, error)
REACT_APP_LOG_LEVEL=info

# ============================================================================
# Optional Configuration
# ============================================================================

# Disable Next.js telemetry (if using Next.js in future)
REACT_APP_NEXT_TELEMETRY_DISABLED=1

# Trust proxy (for deployment behind reverse proxy)
REACT_APP_TRUST_PROXY=true

# Feature flags (JSON string)
REACT_APP_FEATURE_FLAGS={}

# Enable experimental features
REACT_APP_EXPERIMENTS_ENABLED=false

# ============================================================================
# Notes
# ============================================================================

# - All variables must start with REACT_APP_ to be accessible in React
# - Changes to .env require restarting the development server (npm start)
# - Never commit .env file to version control (use .env.example instead)
# - For production deployment, set these in your hosting platform's environment settings
